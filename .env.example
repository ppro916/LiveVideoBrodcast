# Copy to .env and export before running (the app reads plain environment variables).
# Port the Flask server listens on (default 5050)
PORT=5050
# Bind address (default 0.0.0.0)
HOST=0.0.0.0
# Optional: your own TLS certificate and key. If unset, an ad-hoc self-signed cert is generated at start-up.
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem
