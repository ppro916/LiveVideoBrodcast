<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Live</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:#000;color:#e6edf3;font-family:system-ui,sans-serif;overflow:hidden}
#gate{position:fixed;inset:0;background:linear-gradient(160deg,#05070a,#0d1117);display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:18px;z-index:50;text-align:center;padding:24px}
#gate h1{font-size:22px;letter-spacing:3px}
#gate p{color:#8b949e;font-size:13px}
#gate button{padding:16px 40px;border:none;border-radius:40px;background:#da3633;color:#fff;font:800 15px system-ui;letter-spacing:2px;cursor:pointer}
#gate button:hover{opacity:.88}
#player{position:fixed;inset:0;background:#000}
#v{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000}
#adlayer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#000;z-index:4}
#adlayer video,#adlayer img{width:100%;height:100%;object-fit:contain}
.adtext{width:100%;height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:6%;font-weight:800;font-size:clamp(22px,6vw,90px);line-height:1.12}
#sctile{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#05070a;font:800 clamp(22px,5vw,64px) system-ui;letter-spacing:4px;z-index:4;text-align:center;padding:20px}
#ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#8b949e;font:13px monospace;z-index:3;text-align:center;padding:20px}
#live{position:absolute;top:12px;left:12px;z-index:7;background:#da3633;color:#fff;font:800 11px system-ui;
  letter-spacing:1.5px;padding:5px 11px;border-radius:5px;display:flex;align-items:center;gap:6px}
#live .d{width:7px;height:7px;border-radius:50%;background:#fff;animation:bp 1.1s infinite}
@keyframes bp{50%{opacity:.25}}
#label{position:absolute;top:12px;right:12px;z-index:7;background:rgba(5,7,10,.72);border:1px solid #21262d;
  color:#c9d1d9;font:11px monospace;padding:5px 11px;border-radius:5px}
#lower{position:absolute;left:0;right:0;bottom:0;padding:0 14px 14px;z-index:7;pointer-events:none}
.lt{background:linear-gradient(90deg,#0b3d91 0%,#1f6feb 60%,rgba(31,111,235,0) 100%);padding:7px 16px;
  font:800 12px system-ui;letter-spacing:2.5px;color:#cfe3ff;display:inline-block;border-radius:4px 4px 0 0}
.lbody{background:rgba(5,7,10,.9);border-left:4px solid #f0b429;padding:10px 16px;border-radius:0 8px 8px 0;
  display:flex;gap:26px;align-items:center;flex-wrap:wrap}
.lbody .l1{font:800 26px system-ui}
.lbody .l2{font:700 17px system-ui;color:#9fb0c4}
.lbody .ln{font:700 14px system-ui;color:#f0b429}
#bar{position:absolute;bottom:12px;right:12px;z-index:9;display:flex;gap:6px}
#bar button{background:rgba(13,17,23,.86);border:1px solid #30363d;color:#e6edf3;border-radius:6px;
  padding:8px 12px;font:700 11px system-ui;cursor:pointer}
#bar button:hover{border-color:#1f6feb}
.hidden{display:none !important}
</style></head><body>

<div id="gate">
  <h1>LIVE BROADCAST</h1>
  <p>Tap below to join the stream (needed for audio)</p>
  <button id="gobtn">▶ WATCH LIVE</button>
</div>

<div id="player" class="hidden">
  <video id="v" autoplay playsinline></video>
  <div id="adlayer" class="hidden"></div>
  <div id="sctile" class="hidden"></div>
  <div id="ph">CONNECTING…</div>
  <div id="live"><span class="d"></span><span id="livetxt">LIVE</span></div>
  <div id="label">—</div>
  <div id="lower" class="hidden"></div>
  <div id="bar">
    <button id="bmute">🔊 SOUND</button>
    <button id="bfs">⛶ FULL</button>
  </div>
</div>

<script>
(function(){
'use strict';
function log(){var a=[].slice.call(arguments);console.log.apply(console,a);}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function gid(){try{if(window.crypto&&crypto.getRandomValues){var a=new Uint8Array(6);crypto.getRandomValues(a);return Array.from(a).map(function(x){return x.toString(16).padStart(2,'0');}).join('');}}catch(e){}return 'v-'+Math.random().toString(36).slice(2)+Date.now().toString(36);}
var myId;try{myId=sessionStorage.getItem('viewerId');}catch(e){}
if(!myId){myId=gid();try{sessionStorage.setItem('viewerId',myId);}catch(e){}}
var $id=function(x){return document.getElementById(x);};

var since=0, program=null, score={}, peers={}, streams={}, pending={},
    currentSub=null, soundOn=true, started=false, fail=0;

/* ---------- net ---------- */
function post(p,b){return fetch(p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(function(r){return r.json();});}
function sig(to,evt,data){return post('/signal',{from:myId,to:to,event:evt,data:data||{}});}

/* ---------- webrtc ---------- */
function closePeer(cid){var e=peers[cid];if(!e)return;
  try{e.pc.onicecandidate=null;e.pc.onconnectionstatechange=null;e.pc.ontrack=null;e.pc.close();}catch(x){}
  delete peers[cid];delete streams[cid];}
function subscribe(cid){
  if(!cid||peers[cid]||pending[cid])return;
  pending[cid]=1;setTimeout(function(){delete pending[cid];},6000);
  log('subscribe '+cid);sig(cid,'watch_request',{}).catch(function(){delete pending[cid];});}
function unsubscribe(cid){
  var e=peers[cid];
  if(e){sig(e.camClientId,'stop_watching',{}).catch(function(){});closePeer(cid);}
  delete pending[cid];}
function handleOffer(cid,camSid,sdp){
  closePeer(cid);delete pending[cid];
  var pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});
  peers[cid]={pc:pc,camClientId:camSid};
  pc.ontrack=function(ev){
    if(ev.streams&&ev.streams[0]){streams[cid]=ev.streams[0];log('✓ track '+cid);render();playVideo();}};
  pc.onicecandidate=function(ev){if(ev.candidate)sig(camSid,'ice',{candidate:ev.candidate});};
  pc.onconnectionstatechange=function(){log('viewer->'+cid+' '+pc.connectionState);
    if(pc.connectionState==='failed'){closePeer(cid);setTimeout(function(){if(currentSub===cid)subscribe(cid);},1200);}};
  return pc.setRemoteDescription(new RTCSessionDescription(sdp))
    .then(function(){return pc.createAnswer();})
    .then(function(a){return pc.setLocalDescription(a);})
    .then(function(){return sig(camSid,'answer',{sdp:{type:pc.localDescription.type,sdp:pc.localDescription.sdp}});});}

function syncSub(){
  var want=null;
  if(program){
    if(program.source==='camera')want=program.camera_id;
    else want=currentSub;              /* ad/slate मध्ये जुने connection तसेच ठेव */
  }
  if(want!==currentSub){
    if(currentSub)unsubscribe(currentSub);
    currentSub=want||null;
    if(currentSub)subscribe(currentSub);
  }}

/* ---------- ad / slate ---------- */
function adNode(ad,muted){
  var el;
  if(ad.kind==='video'){el=document.createElement('video');el.src=ad.url;el.autoplay=true;el.playsInline=true;el.muted=!!muted;
    el.onerror=function(){el.replaceWith(txtNode('MEDIA ERROR'));};}
  else if(ad.kind==='image'){el=document.createElement('img');el.src=ad.url;
    el.onerror=function(){el.replaceWith(txtNode('MEDIA ERROR'));};}
  else{el=txtNode(ad.text||ad.title||'AD');el.style.background=ad.bg||'#0b3d91';el.className='adtext';}
  return el;}
function txtNode(t){var d=document.createElement('div');d.className='adtext';d.style.background='#0b3d91';d.textContent=t;return d;}

/* ---------- render ---------- */
function playVideo(){
  var v=$id('v');
  if(!v.srcObject)return;
  v.muted=!soundOn;
  v.play().catch(function(){
    /* autoplay blocked -> mute आणि पुन्हा प्रयत्न */
    v.muted=true;soundOn=false;$id('bmute').textContent='🔇 MUTED';
    v.play().catch(function(){log('play blocked');});});}

function render(){
  var p=program||{source:'slate',title:'STANDBY'};
  var v=$id('v'),ad=$id('adlayer'),sc=$id('sctile'),ph=$id('ph');
  ad.classList.add('hidden');ad.innerHTML='';sc.classList.add('hidden');

  if(p.source==='camera'){
    var s=streams[p.camera_id];
    if(s){if(v.srcObject!==s){v.srcObject=s;playVideo();}v.style.display='block';ph.style.display='none';}
    else{v.style.display='block';ph.style.display='flex';ph.textContent='CONNECTING TO '+p.camera_id+' …';}
    $id('label').textContent=p.title||p.camera_id||'';
    $id('live').classList.remove('hidden');
  }else if(p.source==='ad'){
    v.style.display='none';v.srcObject=null;ph.style.display='none';
    ad.classList.remove('hidden');ad.appendChild(adNode(p.ad||{},false));
    var av=ad.querySelector('video');if(av){av.muted=!soundOn;av.play().catch(function(){});}
    $id('label').textContent='ADVERTISEMENT';
    $id('live').classList.add('hidden');
  }else{
    v.style.display='none';v.srcObject=null;ph.style.display='none';
    sc.classList.remove('hidden');sc.textContent=p.title||'STANDBY';
    $id('label').textContent='';
    $id('live').classList.add('hidden');}

  var L=$id('lower');
  if(score.visible&&(score.title||score.line1||score.line2)){
    L.classList.remove('hidden');
    L.innerHTML=(score.title?'<div class="lt">'+esc(score.title)+'</div>':'')+
      '<div class="lbody">'+
      (score.line1?'<span class="l1">'+esc(score.line1)+'</span>':'')+
      (score.line2?'<span class="l2">'+esc(score.line2)+'</span>':'')+
      (score.note?'<span class="ln">'+esc(score.note)+'</span>':'')+'</div>';}
  else L.classList.add('hidden');
  syncSub();}

/* ---------- events ---------- */
function handle(e){
  var evt=e.evt,d=e.data;
  if(evt==='program'){program=d;render();}
  else if(evt==='score'){score=d;render();}
  else if(evt==='camera_status'){
    if(d.status!=='online'&&peers[d.camera_id]){unsubscribe(d.camera_id);if(currentSub===d.camera_id)currentSub=null;}
    render();}
  else if(evt==='offer'){
    if(!d.camera_id)return;
    handleOffer(d.camera_id,d.from,d.sdp).catch(function(x){log('offer err '+x.message);});}
  else if(evt==='ice'){
    if(!d.camera_id)return;var p=peers[d.camera_id];
    if(!p||!d.candidate)return;
    p.pc.addIceCandidate(new RTCIceCandidate(d.candidate)).catch(function(){});}
}

/* ---------- poll loop ---------- */
function loop(){
  fetch('/poll?id='+encodeURIComponent(myId)+'&since='+since+'&role=viewer',{cache:'no-store'})
  .then(function(r){return r.json();})
  .then(function(d){
    since=d.since||0;
    if(d.program)program=d.program;
    if(d.score)score=d.score;
    (d.events||[]).forEach(handle);
    render();fail=0;
  })
  .catch(function(e){fail++;log('poll err '+fail);})
  .then(function(){setTimeout(loop,400);});}

/* ---------- UI ---------- */
$id('gobtn').onclick=function(){
  $id('gate').classList.add('hidden');
  $id('player').classList.remove('hidden');
  /* autoplay unlock */
  var v=$id('v');v.muted=false;v.play().catch(function(){});soundOn=true;
  $id('bmute').textContent='🔊 SOUND';
  if(!started){started=true;loop();}};
$id('bmute').onclick=function(){
  soundOn=!soundOn;var v=$id('v');v.muted=!soundOn;
  var av=document.querySelector('#adlayer video');if(av)av.muted=!soundOn;
  $id('bmute').textContent=soundOn?'🔊 SOUND':'🔇 MUTED';
  if(soundOn)v.play().catch(function(){});};
$id('bfs').onclick=function(){
  var el=$id('player');
  if(!document.fullscreenElement){(el.requestFullscreen||el.webkitRequestFullscreen||function(){}).call(el);}
  else{(document.exitFullscreen||document.webkitExitFullscreen||function(){}).call(document);}};

window.addEventListener('beforeunload',function(){
  Object.keys(peers).forEach(function(cid){var e=peers[cid];if(e)sig(e.camClientId,'stop_watching',{});closePeer(cid);});});

log('viewer id='+myId);
})();
</script></body></html>
